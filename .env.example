# DOOYOOSH environment. Copy to .env.local. NEVER commit real values.
# Server-only vars must never be prefixed NEXT_PUBLIC_.

# --- Database / Supabase (project `dooyoosh`, eu-central-1, DEV/STAGING only, spec §12.7) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/dooyoosh
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (spec §12.1). mock = dev/test only; refused when NODE_ENV=production ---
PAYMENT_PROVIDER=mock
# sandbox | live. Only the exact string "live" moves real money.
PAYMENT_MODE=sandbox
# true only for the public MVP demo on Vercel (mock payments, no real money). Ignored/refused with PAYMENT_MODE=live.
ALLOW_MOCK_IN_PRODUCTION=false
# must equal PAYMENT_MODE; anything but "live" shows the permanent demo banner
NEXT_PUBLIC_PAYMENT_MODE=sandbox
# Shared HMAC secret for the mock provider / generic webhook verification
PAYMENT_WEBHOOK_SECRET=
# Stripe (only if the business is registered in PL/EU)
STRIPE_SECRET_KEY=
# Payme (UZ)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_LOGIN=
PAYME_ACCOUNT_FIELD=order_id
# Click (UZ)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="DOOYOOSH <orders@example.com>"

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ISO 4217, 3 letters. Seeds markets.currency; no DB default (spec §12.3). UZS or EUR.
DEFAULT_CURRENCY=UZS
# Bearer token Vercel Cron sends to /api/v1/cron/*
CRON_SECRET=
# 32+ random chars (openssl rand -hex 32). HMAC for guest order/checkout tokens.
ORDER_TOKEN_SECRET=
# postgres (default) | memory (unit tests / local demo only; refused in production)
PAYMENTS_STORE=postgres

# --- Frontend ---
# true = storefront uses local fixtures instead of /api/v1 (dev/demo only; must be false in production)
NEXT_PUBLIC_USE_FIXTURES=false
# true only for local/QA production builds with fixtures; Vercel production build fails with fixtures regardless
NEXT_PUBLIC_ALLOW_FIXTURES=false
# empty = everything from fixtures; "catalog" = catalog/journal/cart/shipping from fixtures, checkout/orders hit the real API
NEXT_PUBLIC_FIXTURES_SCOPE=
# Optional: absolute origin for server-side API calls from RSC (e.g. http://localhost:3000). Empty = derive from request.
INTERNAL_API_ORIGIN=
