# DOOYOOSH environment. Copy to .env.local. NEVER commit real values.
# Server-only vars must never be prefixed NEXT_PUBLIC_.

# --- Database / Supabase (project `dooyoosh`, eu-central-1, DEV/STAGING only, spec §12.7) ---
DATABASE_URL=postgresql://postgres:password@localhost:5432/dooyoosh
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (spec §12.1). mock = dev/test only; refused when NODE_ENV=production ---
PAYMENT_PROVIDER=mock
# sandbox | live. Only the exact string "live" moves real money.
PAYMENT_MODE=sandbox
# Shared HMAC secret for the mock provider / generic webhook verification
PAYMENT_WEBHOOK_SECRET=
# Stripe (only if the business is registered in PL/EU)
STRIPE_SECRET_KEY=
# Payme (UZ)
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_LOGIN=
PAYME_ACCOUNT_FIELD=order_id
# Click (UZ)
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=

# --- Email (Resend) ---
RESEND_API_KEY=
EMAIL_FROM="DOOYOOSH <orders@example.com>"

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# ISO 4217, 3 letters. Seeds markets.currency; no DB default (spec §12.3). UZS or EUR.
DEFAULT_CURRENCY=UZS
# Bearer token Vercel Cron sends to /api/v1/cron/*
CRON_SECRET=
